    "# 올바르게 분류한 이미지\n",
    "# [셀 6] 셀 3의 무작위 예시 10장이 아니라 전체 이미지 10,000장을 확인한다.\n",
    "# 예측이 정답과 같은 이미지의 인덱스를 추출한다.\n",
    "correct_indices = np.where(\n",
    "    all_predictions == labels\n",
    ")[0]\n",
    "\n",
    "# 잘못 분류한 이미지\n",
    "# 예측이 정답과 다른 이미지의 인덱스를 추출한다.\n",
    "wrong_indices = np.where(\n",
    "    all_predictions != labels\n",
    ")[0]\n",
    "\n",
    "\n",
    "# 선택된 인덱스 중 최대 4장을 실제 이미지, 정답, 예측과 함께 보여주는 함수이다.\n",
    "def show_examples(indices, title, count=4):\n",
    "    selected = indices[:count]\n",
    "\n",
    "    # 정답 또는 오답 사례가 하나도 없는 경우에도 오류 없이 종료한다.\n",
    "    if len(selected) == 0:\n",
    "        print(f\"{title}: No examples found\")\n",
    "        return\n",
    "\n",
    "    plt.figure(figsize=(12, 3))\n",
    "\n",
    "    for i, idx in enumerate(selected):\n",
    "        plt.subplot(1, len(selected), i + 1)\n",
    "        plt.imshow(images[idx])\n",
    "\n",
    "        # 이미지 위에 실제 클래스와 예측 클래스를 함께 표시한다.\n",
    "        plt.title(\n",
    "            f\"True: {class_names[labels[idx]]}\\n\"\n",
    "            f\"Pred: {class_names[all_predictions[idx]]}\"\n",
    "        )\n",
    "\n",
    "        plt.axis(\"off\")\n",
    "\n",
    "    plt.suptitle(title)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
