   "cell_type": "code",
   "source": [
    "# [셀 4] 다중 클래스 SVM Hinge Loss를 직접 구현한다.\n",
    "# 한 이미지의 손실: L_i = Σ_{j≠y} max(0, s_j - s_y + 1).\n",
    "# 정답 점수 s_y가 오답 점수보다 최소 1만큼 높기를 요구한다(마진 Δ=1).\n",
    "def svm_hinge_loss(scores, true_labels):\n",
    "    losses = []\n",
    "\n",
    "    for i in range(len(scores)):\n",
    "        # i번째 이미지에서 정답 클래스의 점수를 먼저 가져온다.\n",
    "        correct_score = scores[i, true_labels[i]]\n",
    "        loss = 0.0\n",
    "\n",
    "        for j in range(num_classes):\n",
    "            # 정답 클래스 자체와 비교하는 항은 손실 합산에서 제외한다.\n",
    "            if j == true_labels[i]:\n",
    "                continue\n",
    "\n",
    "            # 오답 점수가 정답 점수보다 충분히 낮지 않으면 양수 손실이 생긴다.\n",
    "            # 예측 자체가 맞더라도 점수 차이가 1보다 작으면 손실이 발생할 수 있다.\n",
    "            margin = scores[i, j] - correct_score + 1\n",
    "            # max(0, margin)은 마진을 만족한 비교의 손실을 0으로 만든다.\n",
    "            # 오답 클래스 9개에 대한 손실을 모두 더해 이미지 한 장의 손실을 구한다.\n",
    "            loss += max(0, margin)\n",
    "\n",
    "        losses.append(loss)\n",
    "\n",
    "    return np.array(losses)\n",
    "\n",
    "\n",
    "# 선택한 10개 이미지의 Loss\n",
    "losses = svm_hinge_loss(\n",
    "    example_scores,\n",
    "    example_labels\n",
    ")\n",
    "\n",
    "# 선택한 이미지 10장의 SVM 손실을 평균 낸다.\n",
    "# 이 손실은 분석용일 뿐이며 역전파나 가중치 업데이트는 수행하지 않는다.\n",
    "average_loss = losses.mean()\n",
    "\n",
    "# 이미지별 손실과 전체 평균 손실을 확인하기 쉽게 출력한다.\n",
    "loss_df = pd.DataFrame({\n",
    "    \"Image\": [f\"Image {i+1}\" for i in range(10)],\n",
    "    \"True Label\": [class_names[y] for y in example_labels],\n",
    "    \"SVM Loss\": losses\n",
    "})\n",
    "\n",
    "display(loss_df.round(4))\n",
    "\n",
    "print(f\"Average SVM Hinge Loss: {average_loss:.4f}\")"
   ],
