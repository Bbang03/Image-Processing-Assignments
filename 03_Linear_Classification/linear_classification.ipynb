      "100%|██████████| 170M/170M [10:41<00:00, 266kB/s]\n"
     ]
    },
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Images: (10000, 32, 32, 3)\n",
      "Labels: (10000,)\n",
      "Classes: ['airplane', 'automobile', 'bird', 'cat', 'deer', 'dog', 'frog', 'horse', 'ship', 'truck']\n"
     ]
    }
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# 이미지 평탄화 및 정규화\n"
    "X = images.reshape(len(images), -1)\n",
    "# 픽셀값을 float32로 변환한 뒤 255로 나누어 [0, 1] 범위로 정규화한다.\n",
    "X = X.astype(np.float32) / 255.0\n",
    "\n",
    "# 클래스 10개, 이미지 특성 3072개\n",
    "# 출력 클래스는 10개이고, 클래스마다 이미지 벡터에 대응하는 3,072개 가중치가 필요하다.\n",
    "num_classes = 10\n",
    "num_features = 32 * 32 * 3\n",
    "\n",
    "# 작은 무작위 가중치\n",
    "# W의 형태는 (10, 3072): 각 행이 하나의 클래스를 위한 가중치 벡터이다.\n",
    "# 평균 0, 표준편차 0.01인 정규분포에서 작은 무작위 값을 생성한다.\n",
    "# 이 값들은 학습된 특징이 아니며, 이후 코드 어디에서도 업데이트하지 않는다.\n",
    "W = rng.normal(\n",
    "    loc=0.0,\n",
    "    scale=0.01,\n",
    "    size=(num_classes, num_features)\n",
    ").astype(np.float32)\n",
    "\n",
    "# 편향은 모두 0\n",
    "# b는 클래스마다 하나씩 있는 편향으로, 과제 조건에 따라 모두 0으로 둔다.\n",
    "b = np.zeros(num_classes, dtype=np.float32)\n",
    "\n",
    "# 입력 행렬·가중치·편향의 크기를 확인하고 초기 가중치의 통계량도 확인한다.\n",
    "print(\"X shape:\", X.shape)\n",
    "print(\"W shape:\", W.shape)\n",
    "print(\"b shape:\", b.shape)\n",
    "print(\"Weight mean:\", W.mean())\n",
    "print(\"Weight std:\", W.std())"
   ],
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "Dkd-pIOwArWr",
    "outputId": "669b5d7b-f64e-43c5-8ee3-c20348486dc5"
   },
   "execution_count": 2,
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "X shape: (10000, 3072)\n",
      "W shape: (10, 3072)\n",
      "b shape: (10,)\n",
      "Weight mean: 9.0713336e-05\n",
      "Weight std: 0.010043674\n"
     ]
    }
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Linear Classifier\n",
    "# [셀 3] 선형 점수 함수 f(x) = Wx + b를 구현한다.\n",
    "# 여러 이미지가 X의 '행'에 저장되어 있으므로, 실제 계산은 X @ W.T + b로 표현한다.\n",
    "# 행렬 크기: (10000, 3072) @ (3072, 10) → (10000, 10).\n",
    "# 출력의 각 행에는 해당 이미지의 10개 클래스 점수가 들어 있다.\n",
    "def linear_classifier(X, W, b):\n",
    "    return X @ W.T + b\n",
    "\n",
    "\n",
    "# 전체 이미지의 클래스 점수 계산\n",
    "# 전체 이미지의 점수를 한꺼번에 계산한다. 이 점수는 확률이 아니며 음수도 가능하다.\n",
    "all_scores = linear_classifier(X, W, b)\n",
    "# axis=1은 이미지별 클래스 방향이다. 가장 높은 점수의 인덱스를 예측 클래스로 택한다.\n",
    "all_predictions = np.argmax(all_scores, axis=1)\n",
    "\n",
    "# 예시 이미지 10장 무작위 선택\n",
    "# 과제에서 개별 점수를 보여주기 위해 이미지 10장을 중복 없이 무작위로 고른다.\n",
    "# 셀 1에서 만든 동일한 난수 생성기를 사용하므로 실행 순서가 같으면 선택도 재현된다.\n",
    "example_indices = rng.choice(\n",
    "    len(images),\n",
    "    size=10,\n",
    "    replace=False\n",
    ")\n",
    "\n",
    "# 선택된 이미지에 대응하는 점수·정답·예측값만 따로 추출한다.\n",
    "example_scores = all_scores[example_indices]\n",
    "example_labels = labels[example_indices]\n",
    "example_predictions = all_predictions[example_indices]\n",
    "\n",
    "# 예시 이미지 출력\n",
    "# 2행×5열로 이미지 10장을 배치하고, 실제 클래스(True)와 예측(Pred)을 함께 표시한다.\n",
    "plt.figure(figsize=(15, 6))\n",
    "\n",
    "for i, idx in enumerate(example_indices):\n",
    "    plt.subplot(2, 5, i + 1)\n",
    "    plt.imshow(images[idx])\n",
    "    plt.title(\n",
    "        f\"True: {class_names[labels[idx]]}\\n\"\n",
    "        f\"Pred: {class_names[all_predictions[idx]]}\"\n",
    "    )\n",
    "    plt.axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# 10개 클래스의 점수 출력\n",
    "# 각 이미지의 10개 클래스 원본 점수를 표로 정리한다.\n",
    "# 값이 가장 큰 열이 예측 클래스가 되지만, 점수 그 자체가 확률은 아니다.\n",
    "score_df = pd.DataFrame(\n",
    "    example_scores,\n",
    "    columns=class_names,\n",
    "    index=[f\"Image {i+1}\" for i in range(10)]\n",
    ")\n",
    "\n",
    "print(\"Class Scores\")\n",
    "display(score_df.round(4))\n",
    "\n",
    "# 예측 결과 비교\n",
    "# 정답과 예측을 비교해 Correct 열에 맞음(True) / 틀림(False)을 기록한다.\n",
    "prediction_df = pd.DataFrame({\n",
    "    \"Image\": [f\"Image {i+1}\" for i in range(10)],\n",
    "    \"True Label\": [class_names[y] for y in example_labels],\n",
    "    \"Predicted\": [class_names[y] for y in example_predictions],\n",
    "    \"Correct\": example_labels == example_predictions\n",
    "})\n",
    "\n",
    "print(\"Prediction Results\")\n",
    "display(prediction_df)"
   ],
