   "cell_type": "code",
   "source": [
    "# [셀 5] Softmax: 원본 점수 s_j를 exp(s_j) / Σ_k exp(s_k)로 정규화한다.\n",
    "# 결과는 각 클래스에 대해 0~1 값을 가지며, 한 이미지의 값들을 합하면 1이 된다.\n",
    "def softmax(scores):\n",
    "    # 지수 계산의 오버플로를 방지하기 위해 이미지별 최대 점수를 빼 준다.\n",
    "    # 모든 점수에서 같은 상수를 빼도 Softmax 확률은 변하지 않는다.\n",
    "    shifted_scores = scores - np.max(\n",
    "        scores,\n",
    "        axis=1,\n",
    "        keepdims=True\n",
    "    )\n",
    "\n",
    "    # 지수함수를 적용하여 양수 값으로 변환한다.\n",
    "    exp_scores = np.exp(shifted_scores)\n",
    "\n",
    "    # 각 이미지의 클래스별 지수값을 그 이미지의 지수값 합계로 나눈다.\n",
    "    # Softmax는 원본 점수의 순서를 보존하므로 argmax 예측 클래스도 동일하다.\n",
    "    probabilities = exp_scores / np.sum(\n",
    "        exp_scores,\n",
    "        axis=1,\n",
    "        keepdims=True\n",
    "    )\n",
    "\n",
    "    return probabilities\n",
    "\n",
    "\n",
    "# Softmax 적용\n",
    "# 셀 3에서 고른 동일한 이미지 10장에 Softmax를 적용한다.\n",
    "probabilities = softmax(example_scores)\n",
    "\n",
    "# 원본 점수와 확률 비교 (앞의 3개 이미지)\n",
    "# 앞의 3개 이미지에 대해 10개 클래스 원본 점수와 확률을 나란히 비교한다.\n",
    "for i in range(3):\n",
    "    comparison = pd.DataFrame({\n",
    "        \"Class\": class_names,\n",
    "        \"Original Score\": example_scores[i],\n",
    "        \"Softmax Probability\": probabilities[i]\n",
    "    })\n",
    "\n",
    "    print(f\"\\nImage {i+1}\")\n",
    "    display(comparison.round(4))\n",
    "\n",
    "\n",
    "# 모든 예시 이미지의 확률 합 확인\n",
    "# 각 이미지에서 10개 클래스의 확률을 더한다.\n",
    "probability_sums = probabilities.sum(axis=1)\n",
    "\n",
    "sum_df = pd.DataFrame({\n",
    "    \"Image\": [f\"Image {i+1}\" for i in range(10)],\n",
    "    \"Probability Sum\": probability_sums\n",
    "})\n",
    "\n",
    "display(sum_df.round(6))\n",
    "\n",
    "print(\n",
    "    \"All probabilities sum to 1:\",\n",
    "    # 부동소수점 계산 오차를 허용하며, 모든 합계가 1에 가까운지 검증한다.\n",
    "    np.allclose(probability_sums, 1.0)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Same predictions after Softmax:\",\n",
    "    # Softmax 전후의 최고 점수 클래스가 동일한지도 확인한다.\n",
    "    # 단, 학습되지 않은 모델의 Softmax 값을 실제 신뢰도로 해석해서는 안 된다.\n",
    "    np.array_equal(\n",
    "        np.argmax(probabilities, axis=1),\n",
    "        example_predictions\n",
    "    )\n",
    ")"
   ],
