    "# [셀 7] 클래스별 무작위 가중치가 어떤 모습인지 이미지로 시각화한다.\n",
    "plt.figure(figsize=(15, 6))\n",
    "\n",
    "# W의 각 행은 하나의 클래스에 대응하며, 총 10개 클래스 모두 시각화한다.\n",
    "for i in range(num_classes):\n",
    "    # 클래스별 가중치 벡터를 이미지 형태로 변환\n",
    "    # 클래스별 가중치 3,072개를 원본 이미지와 같은 32×32×3 형태로 되돌린다.\n",
    "    weight_image = W[i].reshape(32, 32, 3)\n",
    "\n",
    "    # 시각화를 위해 0~1 범위로 변환\n",
    "    # 가중치에는 음수도 있으므로, 그림을 그리기 전에 표시용 최솟값·최댓값을 구한다.\n",
    "    w_min = weight_image.min()\n",
    "    w_max = weight_image.max()\n",
    "\n",
    "    # 클래스별 가중치를 [0, 1]로 변환해 RGB 이미지로 표시한다.\n",
    "    # 1e-12는 최댓값과 최솟값이 같을 때 0으로 나누는 상황을 막는다.\n",
    "    # 여기서 바뀌는 것은 weight_image뿐이며, 분류에 사용한 원본 W는 그대로이다.\n",
    "    weight_image = (\n",
    "        (weight_image - w_min) / (w_max - w_min + 1e-12)\n",
    "    )\n",
    "\n",
    "    plt.subplot(2, 5, i + 1)\n",
    "    plt.imshow(weight_image)\n",
    "    plt.title(class_names[i])\n",
    "    plt.axis(\"off\")\n",
    "\n",
    "# 학습하지 않았으므로 객체의 모양이나 클래스 특징 대신 무작위 노이즈 패턴이 예상된다.\n",
    "plt.suptitle(\"Randomly Initialized Class Weights\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
